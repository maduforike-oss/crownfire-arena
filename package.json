{
  "name": "crowdfire-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mobile": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "check": "tsc && tsc -p server/tsconfig.json --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "multiplayer:host": "npm run build && node server/lan-server.mjs",
    "multiplayer:serve": "node server/lan-server.mjs",
    "social:dev": "tsx watch server/src/index.ts",
    "social:start": "node server-dist/index.js",
    "test:social": "node server/test/social-smoke.mjs"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "phaser": "^3.90.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
